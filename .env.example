# Development: backend running on your PC.
# Set this to the public HTTPS API origin before building for deployment.
# Without this value, deployed sites request /api on the website's own origin.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Required only for the embedded Naver map test screen.
# Register the website origin in the Naver Cloud console for this public key.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
